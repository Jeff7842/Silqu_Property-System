# Copy to .env.local and fill in real values. .env.local is never committed.

# ---- Database (Neon) ----
# POOLED — used by the app at runtime (src/server/db/client.ts)
DATABASE_URL=
# DIRECT — used by the Prisma CLI for migrations (prisma.config.ts). Same
# host as DATABASE_URL minus the "-pooler" segment.
DATABASE_URL_UNPOOLED=

# ---- Auth ----
# openssl rand -base64 32 (or: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
AUTH_SECRET=

# ---- Upstash Redis (rate limiting) ----
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- Cloudflare R2 (property photo uploads) ----
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_PUBLIC=silqu-public
R2_PUBLIC_BASE_URL=
