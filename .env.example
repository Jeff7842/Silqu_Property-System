# Copy to .env.local and fill in real values. .env.local is never committed.

# ---- Core ----
# Base URL this deployment is reachable at. Used to build absolute links in
# emails and notifications (src/server/services/email/client.ts).
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Production subdomains per portal (build plan section 3.4) : path-based
# routing is used instead in development, so these are unused until deploy.
NEXT_PUBLIC_BUSINESS_HOST=app.silqu.co.ke
NEXT_PUBLIC_TENANT_HOST=my.silqu.co.ke
NEXT_PUBLIC_PLATFORM_HOST=platform.silqu.co.ke

# ---- Database (Neon) ----
# POOLED : used by the app at runtime (src/server/db/client.ts)
DATABASE_URL=
# DIRECT : used by the Prisma CLI for migrations (prisma.config.ts). Same
# host as DATABASE_URL minus the "-pooler" segment.
DATABASE_URL_UNPOOLED=

# ---- Auth ----
# openssl rand -base64 32 (or: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
# Encrypts platform TOTP secrets at rest. Not yet consumed by code : TOTP
# second-factor login (build plan section 3.3) is a deferred, flagged gap,
# see src/server/auth/platform.ts.
TOTP_ENCRYPTION_KEY=
# Comma-separated emails allowed to sign in to the platform portal. Not yet
# consumed by code : see the TOTP note above, same deferred gap.
PLATFORM_EMAIL_ALLOWLIST=

# ---- Upstash Redis (rate limiting) ----
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- Cloudflare R2 (property photos public, tenant documents private) ----
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_PUBLIC=silqu-public
R2_BUCKET_PRIVATE=silqu-private
R2_PUBLIC_BASE_URL=
# Optional : src/server/services/r2/client.ts derives this from
# R2_ACCOUNT_ID if unset, only needed to override the default endpoint.
R2_ENDPOINT=

# ---- Upstash QStash (background jobs) ----
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# Public base URL QStash calls back into (ngrok URL in dev). Re-run
# scripts/qstash-schedules.mjs whenever this changes.
QSTASH_TARGET_BASE_URL=

# ---- M-Pesa Daraja (sandbox) ----
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
# Public callback URLs Safaricom calls back into (ngrok URL in dev).
MPESA_CALLBACK_URL=
MPESA_TIMEOUT_URL=

# ---- Resend (transactional email) ----
# https://resend.com/api-keys : leave blank to keep email sends logged-only (dev default)
RESEND_API_KEY=
# Must be a verified sender on your Resend account/domain
RESEND_FROM_EMAIL=

# ---- Go reports service (build plan section 10a) ----
# Not built yet : placeholders for the Phase 10 reports microservice.
REPORTS_SERVICE_URL=http://localhost:8080
REPORTS_SERVICE_SECRET=

# ---- Plans (whole KES) ----
# Documentation only : currently hardcoded as constants in
# src/server/actions/signup.actions.ts and mpesa.actions.ts rather than read
# from env. Recorded here so the numbers are visible without reading code.
PLAN_MONTHLY_PRICE=2500
PLAN_ANNUAL_PRICE=25000
PLAN_MONTHLY_UNIT_LIMIT=50
